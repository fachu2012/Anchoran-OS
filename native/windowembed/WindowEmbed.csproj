<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Anchoran's window-embedding helper: launches a real external
    Windows app and reparents its window into Anchoran's own window
    (SetParent + strips its title bar/frame), then keeps it positioned
    over the matching spot in Anchoran's UI as that spot moves/resizes
    — see Program.cs for the full protocol and honest limitations.
    Same rationale as native/kioskhook for being a separate
    self-contained .NET executable rather than a native Node addon: no
    C/C++ toolchain or Electron-ABI native-module rebuild required,
    only the .NET SDK already used for kioskhook.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AnchoranWindowEmbed</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

</Project>
